// ─────────────────────────────────────────────────────────────────────────────
// iMach — Database Schema (MongoDB / Prisma)
//
// Design notes
// ─────────────
// • Good is the GLOBAL reference catalog: Business listings always reference it.
// • Listing is the atomic tradable unit (business × good, unique).
//   All interactions (Inquiry / Offer / Follow / PriceLog) hang off Listing,
//   so future "specialized markets" can be added as a pure curation overlay
//   (Market + MarketGoodRule) without touching the core tables.
// • Seller and buyer are the same entity (Business) — every business owns
//   BOTH arms (sell + buy); what is traded per good lives on Listing.mode.
// • Built for millions of rows:
//     - cursor pagination on _id (monotonic with ObjectId)
//     - compound indexes matching every hot query path
//     - Offer.score is persisted (historical results survive algorithm changes)
// • MongoDB connector has no native enums → validated as strings at the API
//   boundary (class-validator DTOs) so the data layer stays schema-agnostic.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  /// Unique international mobile identity: dial code + national number
  /// WITHOUT the leading trunk 0 — e.g. Iran 0912… → 98912….
  /// The dial comes from the signup country, so two countries can never
  /// collide on the same local number.
  phone           String         @unique
  /// Display full name — "firstName lastName". Kept in sync at write time so
  /// every existing reader (chat, notifications, vitrine) keeps working.
  name            String
  /// Person identity — stored SEPARATELY from the business name on purpose:
  /// in wholesale, buyers want to know WHO they are dealing with (the catalog
  /// header shows the owner's name; photo comes later). Legacy rows keep null
  /// here — their combined `name` still renders everywhere.
  firstName       String?
  lastName        String?
  passwordHash    String
  /// آیا کاربر پسورد واقعی تنظیم کرده؟ کاربران ثبت‌نام سریع (فقط موبایل) این
  /// فیلد را false دارند تا دکمه‌ی چشمک‌زن «ثبت پسورد» در هدر دیده شود.
  /// وقتی setPassword صدا زده شد، true می‌شود و دکمه ناپدید می‌گردد.
  /// پیش‌فرض true: کاربران قدیمی (که همگی با registerUser ساخته شده‌اند) این
  /// فیلد را نداشتند — برای آن‌ها true در نظر می‌گیریم. فقط quickRegister این
  /// فیلد را صریحاً false می‌گذارد.
  passwordSet     Boolean        @default(true)
  role            String         @default("MEMBER") // MEMBER | ADMIN
  country         String         @default("IR") // chosen at signup → default business currency + dial code
  /// UI language chosen at signup (BCP-47 base: fa/en/ar/…) — restored on
  /// future logins once the product goes multilingual.
  language        String         @default("fa")
  /// فاز ۶ مهاجرت — ترجیحات نمایش کاربر (cross-device): تم روشن/تاریک،
  /// رنگ دلخواه هر arm، زبانِ صریحاً انتخاب‌شده. JSON ساده:
  /// { theme?: "light"|"dark", armBuyColor?: string, armSellColor?: string, lang?: string }
  /// null/فیلد غایب = پیش‌فرض سیستم (روشن + رنگ‌های Prototype). سمت فرانت
  /// آینهٔ کوکی imach_theme/imach_arm رنگ‌ها برای رندر SSR می‌ماند — این
  /// فیلد همان انتخاب را بین دستگاه‌ها هم می‌برد (الزام مالک: سوییچ تم از پروفایل).
  prefs           Json?
  businesses      Business[]
  refreshTokens   RefreshToken[]
  /// Basic-data rows this user registered (goods, brands, products) — the
  /// audit trail of who grew the catalog. Null creator = system/seed row.
  createdGoods    Good[]         @relation("GoodCreator")
  createdBrands   Brand[]        @relation("BrandCreator")
  createdProducts Product[]      @relation("ProductCreator")
  /// Attribution: the owner of the catalog / invite link this user signed up
  /// through (?ref={businessSlug}). The auto-follow fires later, when the
  /// referred user finally gets a Business (and therefore a BUY page).
  referredBy      User?          @relation("Referrals", fields: [referredById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  referredById    String?        @db.ObjectId
  referrals       User[]         @relation("Referrals")
  /// Which page of the referrer the invite came from: SELL = catalog link
  /// (referred becomes the referrer's CUSTOMER), BUY = purchase-desk link
  /// (referred becomes the referrer's SUPPLIER). Null = legacy sell default.
  refArm          String?
  /// Phone contacts this user shared via the contacts gate — the user's
  /// private network, stored for the growth engine (who is on iMach, who
  /// was invited, when).
  contacts        Contact[]
  /// In-app notification feed (bell) — follow / offer / quote / contact-joined
  notifications   Notification[]
  /// Files this user uploaded (avatar + anything else) — per-user usage rollup
  files           File[]         @relation("FileOwner")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([referredById])
}

/// Phone contacts a user shared through the contacts gate — یک به چند با User.
/// Raw rows are the user's private network. Membership is NOT stored here:
/// read-time matching against User.phone keeps «عضو iMach» flags fresh as
/// people join later. lastInvitedAt audits the invite loop.
model Contact {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  userId        String    @db.ObjectId
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  /// Normalized Iranian mobile — 09xxxxxxxxx
  phone         String
  lastInvitedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, phone])
  @@index([phone])
}

/// In-app notification — one row per event, owned by the receiving user.
/// Text is NOT stored: the client renders the fa sentence per `type`, so a
/// row is just (type, actor, optional good) + read flag. Actors are
/// denormalized (name/slug snapshot) so renaming a business never rewrites
/// history. Writes go through NotificationsService — errors are swallowed:
/// a notification must never break follow / offer / signup flows.
/// Types (validated at the API boundary, MongoDB has no enums):
///   FOLLOW_SUPPLIER — a buyer followed my SELL page (مشتری جدید)
///   FOLLOW_BUYER    — a supplier followed my BUY page (تامین‌کننده آمد)
///   OFFER           — a direct offer landed on my buy request
///   QUOTE           — the matching engine routed a price inquiry to me
///   CONTACT_JOINED  — a phone from my contacts gate just signed up
model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  /// Actor business/user id — null for system-generated rows
  actorId   String?  @db.ObjectId
  actorName String?
  actorSlug String?
  /// Context label (good name for offer/quote rows)
  good      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, read])
}

/// Rotating refresh tokens — only the SHA-256 hash is stored, so a DB leak
/// cannot be replayed. Revoked rows keep audit history.
model RefreshToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  tokenHash String    @unique
  userId    String    @db.ObjectId
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ─── Catalog (category tree + reference goods) ─────────────────────────────

/// ── Unit table — multilingual units with 3-level classification.
///
/// Three scopes:
///   "base"     — physical measurement units (KILOGRAM, METER, LITER, WATT, …)
///   "retail"   — consumer/single-sale units (PIECE, CAN, BOTTLE, BAG, SACK, …)
///   "wholesale"— bulk packaging containing multiple retail units
///                 (CARTON, BOX, PALLET, JUMBO, …)
///
/// The matching engine uses containsQty to normalize prices for comparison:
///   pricePerBaseUnit = priceMinor / containsQty
///
/// Example:
///   { key: "KILOGRAM", scope: "base",     baseUnitKey: null }
///   { key: "PIECE",   scope: "retail",   baseUnitKey: null }
///   { key: "BOTTLE",  scope: "retail",   baseUnitKey: "MILLILITER", containsQty: null }
///   { key: "CARTON",  scope: "wholesale",baseUnitKey: "PIECE", containsQty: null }
///   { key: "CARTON24",scope: "wholesale",baseUnitKey: "PIECE", containsQty: 24, qtyIsFixed: true }
model Unit {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  key         String  @unique
  nameFa      String
  nameEn      String
  /// فاز ۸ مهاجرت — نام عربی واحد (null = fallback به nameEn در UI عربی)
  nameAr      String?
  /// "base" | "retail" | "wholesale"
  scope       String  @default("base")
  /// null = this IS a root unit | non-null = references another unit's key
  /// (e.g. CARTON → PIECE, SACK50 → KILOGRAM)
  baseUnitKey String?
  /// how many base units in this packaging? null = product-dependent
  containsQty Int?
  /// true = count is fixed (CARTON24 always = 24) | false = user can override
  qtyIsFixed  Boolean @default(false)
  isActive    Boolean @default(true)

  @@index([scope])
  @@index([baseUnitKey])
}

/// Category tree (3–4 levels). Seed comes from trade standards (GS1 GPC / HS
/// skeleton + local B2B naming); user-created goods always attach to a leaf.
model Category {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  parentId   String?    @db.ObjectId
  parent     Category?  @relation("catTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children   Category[] @relation("catTree")
  slug       String     @unique // stable identifier — names are localizable
  nameFa     String
  nameEn     String
  /// فاز ۸ مهاجرت — نام عربی دسته (null = fallback به nameEn در UI عربی)
  nameAr     String?
  /// GS1 GPC Brick code — for global barcode matching and cross-border trade.
  /// Example: "10000335" for "Dates". Enables international matching even when
  /// category trees differ between countries. Optional (null = not yet mapped).
  gs1GpcCode String?
  /// HS Code (Harmonized System) — 4-6 digit chapter for customs and tariffs.
  /// Used by the matching engine to calculate import/export costs when
  /// suggesting cross-border suppliers. Example: "0813" for dried fruit.
  hsCode     String?
  /// Attribute schema for goods under this category:
  /// [{key, fa, en, type: "enum"|"text", options?: [{v, fa, en}], required?: boolean}]
  attrs      Json?
  /// Default wholesale unit prefilled when a reference good is created
  /// under this leaf (KILOGRAM | TON | CARTON | …) — keys stay semantic.
  unit       String?
  /// Hidden subtree (e.g. services before their launch day) — excluded from
  /// every user-facing read; flipping it back on needs no migration.
  isActive   Boolean    @default(true)
  goods      Good[]

  @@index([parentId])
  @@index([gs1GpcCode])
  @@index([hsCode])
}

/// The reference good — a tradeable CLASS ("خرمای خازویی"), NOT a brand×size SKU.
/// Weight/packaging live on Category attrs, brand lives on Listing — so the
/// catalog stays demand-driven and match-friendly across languages.
model Good {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  categoryId  String        @db.ObjectId
  category    Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  nameFa      String // canonical Persian name (or the name the user typed)
  nameEn      String?
  aliases     String[] // extra search terms in any language
  /// Normalized (fa-agnostic) concatenation of names + aliases — powers search
  searchText  String
  unit        String // KILOGRAM | TON | CARTON | SACK | PIECE | LITER | BRANCH | METER | GRAM | SERVICE
  /// Optional external-classification metadata (customs HS 6–10 digits).
  /// Empty today by design — tomorrow it powers export/import workflows.
  hsCode      String?
  source      String        @default("SEED") // SEED | USER (legacy origin; superseded by creatorRole)
  status      String        @default("ACTIVE") // ACTIVE | PROVISIONAL (pending review)
  /// Who registered this row: USER (ordinary member) | ADMIN | BRAND_OWNER.
  /// Null = system/seed. Rows stay usable for everyone while PROVISIONAL —
  /// the state only drives the admin gardening queue (approve / merge / delete).
  creatorRole String?
  createdById String?       @db.ObjectId
  createdBy   User?         @relation("GoodCreator", fields: [createdById], references: [id], onUpdate: NoAction)
  listings    Listing[]
  /// SKU-level identities (brand×size) under this class — see Product.
  products    Product[]
  /// فاز ۵ — خریدارهایی که قیمت این کالا را دنبال می‌کنند (شکاف ۱)
  watchers    WatchedGood[]

  @@index([categoryId])
  @@index([searchText])
  /// browse-with-search at scale: leaf filter first, then text
  @@index([categoryId, searchText])
}

/// Brand — optional, resolved/created on the fly when a listing saves.
/// Lives on the listing (not the reference) because the same class is sold
/// under many brands — and most B2B trade is brand-agnostic by default.
/// Brand — a tradeable identity (هیمالیا, مکنزی, کاله).
///
/// Not an attribute — it's a first-class entity with ownership:
///   - ownerId: Business that owns this brand (null = unclaimed)
///   - When ownerId is set, that business gets /brand/[slug] dashboard
///   - Admin can assign/revoke ownership at any time
///
/// Brands are global — shared across all sellers. Each Product references
/// a Brand. Bulk goods (no brand) have productId=null.
model Brand {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String // as entered
  searchText  String    @unique // normalized — natural dedup
  source      String    @default("SEED") // SEED | USER (legacy origin)
  /// ACTIVE | PROVISIONAL — same gardening contract as Good
  status      String    @default("ACTIVE")
  /// Who registered it: USER | ADMIN | BRAND_OWNER (null = system/seed)
  creatorRole String?
  createdById String?   @db.ObjectId
  createdBy   User?     @relation("BrandCreator", fields: [createdById], references: [id], onUpdate: NoAction)
  /// Business that owns this brand (null = unclaimed, admin can assign)
  ownerId     String?   @db.ObjectId
  owner       Business? @relation("BrandOwner", fields: [ownerId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  listings    Listing[]
  products    Product[]
}

/// The shared SKU — the identity layer BETWEEN Good (class) and Listing
/// (seller's offer), built for retailers with hundreds of items
/// (خواسته‌ی کاربر: «سوپرمارکتی که ۲۰۰۰ قلم دارد چرا باید همان کالا را هزاران
/// بار تایپ کند؟ این کالا بین هم‌فروشنده‌ها مشترک است؛ فقط قیمت/موجودی فرق دارد»).
///
/// Contracts it inherits verbatim from Good/Brand (نوع جدید = الگوی آشنا، نه
/// مکانیزم تازه — خط قرمز پیچیدگی):
///   • normalized searchText + find-or-create on save → duplicates converge
///   • ACTIVE | PROVISIONAL gardening — provisional rows stay usable for
///     everyone, they only wait in the admin merge queue
///   • barcode (GTIN) optional: present → exact identity; absent → same fuzzy
///     tolerance as Good. NOT @unique in the schema: Mongo unique indexes
///     index nulls, and most Products (bulk goods) have no barcode —
///     uniqueness is enforced service-side find-or-create; a partial unique
///     index can be added by migration when volume justifies it.
///   • NO structured attrs here — weight/packaging live inside label/searchText
///     (هر فیلد ساختاریافته‌ی اضافه = مسئله‌ی «۲۵۰گرم/۰.۲۵کیلو» در لایه‌ی جدید);
///     the only structured key is barcode. Per-seller data stays on Listing.
///   • Matching NEVER reads Product — the score stays Good-level (خواسته‌ی
///     کاربر: خریدارِ بی‌برند نباید فروشنده‌های مرتبط را از دست بدهد).
model Product {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  goodId       String    @db.ObjectId
  good         Good      @relation(fields: [goodId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  brandId      String?   @db.ObjectId
  brand        Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  /// «تن ماهی مکنزی ۲۵۰ گرم» — the first text that created it (brand + specs)
  label        String
  /// normalized label — same normalizer as Good/Brand, powers find-or-create + picker search
  searchText   String
  /// GTIN/EAN when known — exact identity for packaged branded goods
  barcode      String?
  /// عکس مرجع محصول — اختیاری. می‌تواند از اولین Listingای که این Product را
  /// ساخت بیاید، یا ادمین در پنل بگذارد. در picker و کاتالوگ تجمیعی نشان داده
  /// می‌شود تا کاربر بداند چه می‌خرد.
  imageUrl     String?
  /// ACTIVE | PROVISIONAL | MERGED (mergedIntoId points at the survivor)
  status       String    @default("ACTIVE")
  mergedIntoId String?   @db.ObjectId
  creatorRole  String?
  createdById  String?   @db.ObjectId
  createdBy    User?     @relation("ProductCreator", fields: [createdById], references: [id], onUpdate: NoAction)
  /// Category-level attribute values for this product: {key: value}
  /// e.g. {"weight": "250g", "flavor": "نمکی", "volume_ml": "300"}
  attrs        Json?
  /// Rich metadata from external sources (barcodeapp, Open Food Facts, etc.)
  /// Contains: parsed_brand, clean_name, parsed_attributes, volume_ml,
  /// weight_grams, data_confidence, source, original_name, etc.
  metadata     Json?
  listings     Listing[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([goodId, searchText])
  @@index([barcode])
  @@index([status])
  @@index([brandId]) // brand filter in the reference picker
  @@index([status, brandId]) // groupBy brand sidebar (-picker)
  @@index([status, goodId]) // groupBy category sidebar (picker)
  @@index([status, searchText]) // free-text search with status filter
}

// ─── Business (seller AND buyer identity) ────────────────────────────────────

// The 10 allowed activity types — validated at the API boundary
// (class-validator @IsIn), stored as a plain string:
// PRODUCER | WHOLESALER | RETAILER | DISTRIBUTOR | MERCHANT |
// SALES_AGENT | MARKETER | SERVICE_PROVIDER | CONTRACTOR | BUSINESS_CONSUMER

model Business {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  slug         String  @unique // drives the public arm links: /sell/{slug} /buy/{slug}
  name         String
  activityType String? // optional self-description, chosen later from the panel
  /// صنف — the trade the business works in («سوپرمارکت», «ابزار و یراق»), free
  /// text asked at creation. Powers «کپی از کاتالوگ هم‌صنف‌ها»: a new retailer
  /// finds similar catalogs by trade instead of typing hundreds of items
  /// (خواسته‌ی کاربر: «اولین سوپرمارکت که کالاهاشو وارد کرد بقیه تیک بزنن»).
  trade        String?
  /// Human catalog size — denormalized count of active listings, refreshed
  /// opportunistically. Keeps catalog-search fast at scale (no groupBy per hit).
  catalogCount Int     @default(0)
  city         String
  province     String? // derived from city at write time (matching granularity)
  country      String  @default("IR") // country code of the business
  /// Currency of the catalog (sell arm). Set at business creation from the
  /// owner's signup country; every listing inherits it at write time.
  currency     String  @default("IRR") // ISO 4217
  phone        String?
  isVerified   Boolean @default(false)
  isDemo       Boolean @default(false)

  // ── دسته‌بندی شخصی کاتالوگ (فاز ۳ — طرح ۰۱) ──
  /// فروشنده خودش کاتالوگش را گروه‌بندی می‌کند — چیپ‌های بالای ویترین:
  /// «هاشمی / طارم / فجر / صدری» برای برنج‌فروش، هر چیز دیگری برای آهن‌فروش.
  /// ساختار: [{id: "کوتاه-یکتا", name: "نام فارسی"}] — id را کلاینت می‌سازد
  /// و آگهی‌ها با Listing.catalogCategoryId به آن اشاره می‌کنند.
  /// JSON است چون دسته‌های هر فروشنده شخصی‌اند و جدول جهانی نمی‌خواهند —
  /// این لایه «چیدمان ویترین» است نه «کالای مرجع»؛ هسته‌ی تطابق دست‌نخورده.
  customCategories Json?

  /// Precise geo point of the business — user-consented, optional, set from
  /// the catalog settings map (LocationPicker). Feeds the matcher's distance
  /// tiering later (city → province → exact point). Never rendered publicly
  /// as an exact pin; the public catalog shows only the city.
  lat            Float?
  lng            Float?
  /// Textual address — prefilled from reverse-geocode of the pin, but always
  /// user-editable. This one IS public (shown on the owner's pages).
  address        String?
  /// فاز ۶ مهاجرت (sc-settings «فروشگاه») — ساعت پاسخگویی فروشنده به‌صورت
  /// متن آزاد فارسی («شنبه تا پنج‌شنبه · ۸ تا ۱۸»). نمایش عمومی در کاتالوگ
  /// فاز ۷ می‌آید؛ ذخیره از همین فاز تا تنظیمات مرده نباشد.
  hours          String?
  /// فاز ۶ مهاجرت (sc-settings «فروشگاه») — شرایط پرداخت پیش‌فرض فروشنده
  /// (متن آزاد: «نقدی» / «عندالتحویل» / …). همان قاعدهٔ hours.
  defaultPayTerm String?

  /// فاز ۸ (طرح ۱۴) — تنظیمات اعلانِ این کسب‌وکار. JSON ساده:
  /// { priceChange, suggestions, quoteReplies, push } — همه boolean.
  /// null/فیلد غایب = روشن (پیش‌فرض). نگاشت به انواع اعلان:
  ///   priceChange  → PRICE_CHANGE («تغییر قیمت در تابلوهای من»)
  ///   quoteReplies → QUOTE + OFFER («درخواست‌ها و پاسخ‌های قیمت»)
  ///   suggestions  → FOLLOW_SUPPLIER + FOLLOW_BUYER + CONTACT_JOINED
  ///                  («اتصال‌ها و معرفی‌های تازه‌ی iMach»)
  ///   push         → فقط گیتِ پوشِ وب؛ ردیفِ درون‌برنامه‌ای همیشه ثبت می‌شود
  /// گیتِ خواندن در NotificationsService متمرکز است (push/pushMany).
  notifPrefs Json?

  /// فاز ۹ (شکاف ۶ — د۹) — دستیارهای فعالِ این کسب‌وکار. JSON:
  /// { sell: boolean, buy: boolean } — null/فیلد غایب = هر دو روشن (پیش‌فرض).
  /// «می‌فروشم/می‌خرم/هر دو»ی ثبت‌نام فقط همین پیش‌فرض را تعیین می‌کند؛
  /// کاربر بعداً از پروفایل هر دستیار را جدا خاموش/روشن می‌کند (نیاز
  /// خرده‌فروش‌ها/تالارها/هتل‌ها که بازوی فروش عمده نمی‌خواهند). سوییچرِ
  /// شل فقط دستیارهای فعال را نشان می‌دهد و با تک‌بازو کلاً غیب می‌شود.
  /// حداقل یک دستیار باید روشن بماند (اعتبارسنجی در setArms).
  enabledArms Json?

  ownerId String? @db.ObjectId
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  listings     Listing[]     @relation("listings")
  inquiriesIn  Inquiry[]     @relation("seller")
  inquiriesOut Inquiry[]     @relation("buyer")
  offersSent   Offer[]       @relation("seller")
  offersRecv   Offer[]       @relation("buyer")
  pages        Page[]
  /// فاز ۵ — کالاهایی که این خریدار قیمتشان را دنبال می‌کند (لیست خرید)
  watchedGoods WatchedGood[]
  /// طرح ۸ — کیف پول تومانی (هر کسب‌وکار حداکثر یکی)
  wallet       Wallet?
  /// طرح ۸ — کمپین‌های «صف اول» این فروشنده
  promos       Promo[]
  /// فاز ۶ مهاجرت — گفتگوهای این کسب‌وکار (دو جهت رابطهٔ Thread)
  threadsA     Thread[]      @relation("threadA")
  threadsB     Thread[]      @relation("threadB")
  /// Brands owned by this business (for brand dashboard)
  ownedBrands  Brand[]       @relation("BrandOwner")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([city])
  @@index([ownerId])
  @@index([trade])
}

// ─── WatchedGood (فاز ۵ — شکاف ۱) ────────────────────────────────────────────

/// دنبال‌کردن قیمتِ یک کالا — رابطه‌ی خریدار↔کالا (good-level):
/// ردیف‌های «لیست خرید» از همین‌ها + BUY listingهای موجود ساخته می‌شوند
/// (گزینه‌ی کم‌ریسک مهاجرت: BUY listing منبع حجم/دوره می‌ماند).
/// به‌ازای هر تغییر قیمتِ فعالِ همان کالا، یک اعلان PRICE_CHANGE — با
/// throttle روزانه از طریق lastNotifiedAt.
model WatchedGood {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  businessId     String    @db.ObjectId
  goodId         String    @db.ObjectId
  createdAt      DateTime  @default(now())
  /// آخرین اعلانِ ارسال‌شده — حداکثر یک اعلان قیمت در روز به‌ازای هر کالا
  lastNotifiedAt DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  good     Good     @relation(fields: [goodId], references: [id], onDelete: Cascade)

  @@unique([businessId, goodId])
  @@index([goodId])
}

// ─── PushSubscription (Web Push — VAPID) ─────────────────────────────────────

/// Browser push subscription of a USER (not business) — one row per browser.
/// endpoint is globally unique per subscription; re-subscribe overwrites.
/// Delivery is best-effort: 404/410 from the push service removes the row.
model PushSubscription {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── Listing (the atomic tradable unit) ──────────────────────────────────────

model Listing {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  businessId String @db.ObjectId
  goodId     String @db.ObjectId
  mode       String // SELL | BUY | BOTH

  /// Distinguishing spec of THIS row, derived from attrs at write time
  /// ("weight=500g|packaging=carton"). "" = the plain, unvarianted offer.
  /// One business keeps SEPARATE price/stock rows per variant of the same
  /// reference good («نان آرتا» × بسته کوچک / بسته بزرگ) — without splitting
  /// the good itself.
  variantKey   String  @default("")
  /// Human-readable variant snapshot for cards («۵۰۰ گرمی · کارتن»)
  variantLabel String?

  /// Optional brand of THIS offer (the reference class stays brand-free)
  brandId String? @db.ObjectId
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  /// Shared SKU identity (see Product) — null for bulk goods and for rows
  /// created before this layer; every picker-added row links here.
  productId String?  @db.ObjectId
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  // ── sell side ──
  /// Price in the SMALLEST currency unit (rial / cent …) — always an integer.
  /// Currency is inherited from the business at write time.
  priceMinor Int?
  currency   String? // ISO 4217 (IRR, USD, …)
  stock      Int?
  minOrder   Int?
  /// Category attribute values: {attrKey: value} (weight, packaging …)
  attrs      Json?

  /// فاز ۵ مهاجرت — پکیج‌بندی چندتاییِ این ردیف: [{label, qty, priceMinor?, stock?}]
  /// («کیسهٔ ۱۰ کیلویی · ۸۹۵٬۰۰۰»). خالی = فقط قیمت پایه؛ قیمت هر بسته اختیاری و
  /// اگر خالی باشد از قیمت پایه × نسبت تعدد واحد محاسبه می‌شود (pack-note Prototype).
  packaging Json?

  // ── buy side ──
  volume    Float?
  frequency String? // WEEKLY | MONTHLY | OCCASIONAL

  // ── geo snapshot (business location at write time) ──
  // Mongo relation queries are app-side joins: at scale the matcher must
  // filter listings directly, never through business lookups.
  city     String?
  province String?
  country  String  @default("IR")

  // ── شمارش بازدید عمومی (شکاف ۳ — فاز ۲ بازطراحی) ──
  /// بازدیدهای پنجره‌ی سی‌روزه‌ی جاری — همان عدد کارت‌ها و «عملکرد ۳۰ روز»
  viewCount30     Int       @default(0)
  /// بازدید کل از پیدایش آگهی
  viewCountTotal  Int       @default(0)
  /// شروع پنجره‌ی سی‌روزه — وقتی از ۳۰ روز بگذرد ریست و از امروز شروع می‌شود
  viewWindowStart DateTime?

  // ── دسته‌ی شخصی کاتالوگ (فاز ۳ — طرح ۰۱) ──
  /// id یکی از آیتم‌های Business.customCategories همان کسب‌وکار —
  /// «این کالا در ویترین من زیر کدام دسته بنشیند». اعتبارسنجی سمت سرور؛
  /// حذف دسته، این فیلد را در آگهی‌هایش null می‌کند (نه خود آگهی را).
  catalogCategoryId String?

  /// Soft delete — «حذف» فقط کاتالوگ را ترک می‌کند؛ Inquiry/Offer/PriceLog
  /// (تاریخچه قیمت) می‌ماند. Upsert یک سطر حذف‌شده را دوباره زنده می‌کند.
  isActive Boolean @default(true)

  business  Business   @relation("listings", fields: [businessId], references: [id], onDelete: Cascade)
  good      Good       @relation(fields: [goodId], references: [id])
  inquiries Inquiry[]
  offers    Offer[]
  priceLogs PriceLog[]
  /// طرح ۸ — کمپین‌های فعال/توقف‌شده روی همین کالا (فقط رابطه؛ خواندن از Promo)
  promos    Promo[]    @relation("promoListing")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([businessId, goodId, variantKey])
  @@index([goodId, isActive, mode])
  @@index([businessId])
}

// ─── Interactions ────────────────────────────────────────────────────────────

/// Buyer asked for a price on a seller's catalog listing.
model Inquiry {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  buyerId          String   @db.ObjectId
  sellerId         String   @db.ObjectId
  listingId        String   @db.ObjectId
  volume           Float
  note             String?
  /// Purchase rhythm snapshot from the buyer's BUY listing
  /// (WEEKLY | MONTHLY | OCCASIONAL) — shown as «دوره خرید» on the request card.
  frequency        String?
  /// Delivery expectation snapshot («این ماه», «فوری», …) — free text from
  /// the quote-request form (design 12, phase 6); null until that form exists.
  delivery         String?
  /// فاز ۴ مهاجرت (sc-rfq) — محل تحویل («همدان — درب انبار»؛ پیش‌فرض شهر خریدار).
  deliveryCity     String?
  /// فاز ۴ مهاجرت (sc-rfq) — قیمت هدف اختیاری خریدار (تومان×۱۰؛ جهت مذاکره فروشنده).
  targetPriceMinor Int?
  /// فاز ۴ مهاجرت — یک «استعلام گروهی» (requestQuote) چند Inquiry می‌سازد؛
  /// این کلید همهٔ ردیف‌های همان ارسال را در یک کارت «پیشنهادها» گروه می‌کند.
  /// ردیف‌های legacy مقدار ندارند → هر کدام گروه تک‌نفرهٔ خودشان هستند.
  rfqGroupId       String?
  status           String   @default("NEW") // NEW | ANSWERED | ARCHIVED
  isRead           Boolean  @default(false)
  createdAt        DateTime @default(now())

  buyer   Business @relation("buyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller  Business @relation("seller", fields: [sellerId], references: [id], onDelete: Cascade)
  listing Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([sellerId, isRead, createdAt])
  @@index([buyerId, createdAt])
  @@index([rfqGroupId])
}

/// A price offer — either produced by the matching engine on quote-request,
/// or sent manually by a seller answering an inquiry.
model Offer {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  buyerId    String   @db.ObjectId
  sellerId   String   @db.ObjectId
  listingId  String   @db.ObjectId
  priceMinor Int // smallest currency unit — integer, exact
  currency   String // ISO 4217 — snapshotted from the listing
  minOrder   Int
  score      Int // persisted matching score (0–100)
  isSpecial  Boolean  @default(false)
  note       String?
  /// فاز ۴ مهاجرت (sc-quote) — شرایط پرداخت («نقدی» | «عندالتحویل» | «چک ۳۰ روزه»).
  payTerm    String?
  /// فاز ۴ مهاجرت (sc-quote) — زمان تحویل («همان روز» | «فردا» | «۲ روز»).
  delivTerm  String?
  /// فاز ۴ مهاجرت (sheet-offer-status) — نشان خصوصی خریدار روی این پیشنهاد:
  /// INTERESTED | CONTACTED | REVIEWED · null = بدون وضعیت. فقط خریدار می‌بیند.
  status     String?
  createdAt  DateTime @default(now())

  buyer   Business @relation("buyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller  Business @relation("seller", fields: [sellerId], references: [id], onDelete: Cascade)
  listing Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
}

// ─── Pages (isolated business contexts) ───────────────────────────────────

/// A Page is an independent business context of a Business: SELL = the
/// catalog (تابلوی قیمت من), BUY = the purchase desk (میز خرید). The account
/// is the person; pages are the contexts. MVP caps one page of each type per
/// business (unique index) but the model is multi-page from day one.
model Page {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  type       String // SELL | BUY
  businessId String   @db.ObjectId
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  /// Follow edges where this page is the follower (BUY pages in practice)
  followerEdges Follow[] @relation("pageFollower")
  /// Follow edges where this page is the followed one (SELL pages)
  supplierEdges Follow[] @relation("pageSupplier")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, type])
  @@index([businessId])
}

/// Price tracking — the BUY page of a business follows the SELL page of a
/// supplier. A private subscription to price changes; no social layer.
model Follow {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  followerPageId String   @db.ObjectId // BUY page of the follower
  supplierPageId String   @db.ObjectId // SELL page of the followed supplier
  /// True when the edge was born from a referral signup (?ref= auto-follow) —
  /// powers the «با لینک» badge and future reward attribution.
  viaRef         Boolean  @default(false)
  /// طرح ۸ (U60) — منبعِ رسیدنِ این یال: ORGANIC (خودش در اپ پیدا کرد) |
  /// SHARED (از لینک اشتراکی/کاتالوگ/لیست) | PROMO (از نمایش پرومو).
  /// ردیف‌های قدیمی‌تر ORGANIC تلقی می‌شوند؛ viaRef=true و source خالی → SHARED.
  /// تحلیل «از کجا آمدند» (شیت دنبال‌کنندگان + خط خلاصهٔ عددی) از اینجا می‌سد.
  source         String?
  /// فاز ۵ مهاجرت — نوع مشتری از دید فروشنده: PASSING(گذری) | PARTNER(همکار)
  /// | CONTRACT(قراردادی). null = گذری. تعیین‌کننده‌اش فروشنده است (شیت
  /// دنبال‌کنندگان / sheet-cust-type)؛ قیمت نهایی خریدار همین‌جا از آن می‌آید.
  /// بر مدل جدا CustomerType ترجیح داده شد — همان الگوی source روی همان یال.
  custType       String?
  createdAt      DateTime @default(now())

  followerPage Page @relation("pageFollower", fields: [followerPageId], references: [id], onDelete: Cascade)
  supplierPage Page @relation("pageSupplier", fields: [supplierPageId], references: [id], onDelete: Cascade)

  @@unique([followerPageId, supplierPageId])
  @@index([supplierPageId])
}

/// Price history per listing → powers trends and "recently updated" badges.
/// Minor-unit integers — same precision as the listing itself.
model PriceLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  listingId String   @db.ObjectId
  oldMinor  Int
  newMinor  Int
  createdAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, createdAt])
}

// ─── طرح ۸ — کیف پول تومانی + کمپین «صف اول» (پرداخت به‌ازای نتیجه) ────────

/// کیف پول تومانی هر کسب‌وکار — الگوی اینستاگرام: پول واقعی، نه «اعتبار».
/// موجودی به minor واحد پایه (ریال) ذخیره می‌شود؛ نمایش همیشه به تومان.
model Wallet {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  businessId   String      @unique @db.ObjectId
  balanceMinor Int         @default(0) // IRR minor — نمایش به تومان = ÷۱۰
  txns         WalletTxn[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

/// تراکنش‌های کیف — شارژ، خرج کمپین، پاداش دعوت، برگشت بودجه.
/// CHARGE = شارژ درگاه · PROMO_SPEND = کسر به‌ازای رویداد کمپین ·
/// REFERRAL_REWARD = پاداش دعوت (+۵٬۰۰۰ تومان پس از اولین ذخیرهٔ معرفی‌شده) ·
/// REFUND = برگشت باقیماندهٔ کمپین متوقف‌شده.
model WalletTxn {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  walletId    String   @db.ObjectId
  type        String // CHARGE | PROMO_SPEND | REFERRAL_REWARD | REFUND
  amountMinor Int // مثبت = واریز، منفی = برداشت
  ref         String? // شناسهٔ کمپین/رسید/معرفی
  description String?
  createdAt   DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
}

/// کمپین «صف اول» — پرداخت به‌ازای نتیجه (U66): ۱٬۰۰۰ تومان هر نمایشِ
/// هدفمند + ۵٬۰۰۰ تومان هر ذخیرهٔ حاصل. بدون مدت ۷روزه؛ بودجه که تمام
/// شود نمایش می‌ایستد. صرفاً دیده‌شدن می‌خرد — رتبهٔ تطبیق مستقل می‌ماند.
model Promo {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  businessId  String    @db.ObjectId // فروشندهٔ پرداخت‌کننده
  listingId   String    @db.ObjectId // کالای هدف
  budgetMinor Int // بودجهٔ تعهدی
  spentMinor  Int       @default(0) // خرج‌شده (مشاهده + ذخیره)
  isActive    Boolean   @default(true)
  stoppedAt   DateTime? // توقف دستی یا خالی‌شدن بودجه
  createdAt   DateTime  @default(now())

  business Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  listing  Listing      @relation("promoListing", fields: [listingId], references: [id], onDelete: Cascade)
  events   PromoEvent[]

  @@index([isActive])
  @@index([listingId, isActive])
}

/// رویداد کمپین — هر خریدار به‌ازای هر کمپین و هر نوع، یکتا (U07):
/// VIEW = ۱٬۰۰۰ تومان (فقط خریدارِ همان کالا که کاتالوک فروشنده را ذخیره
/// نکرده باشد) · FOLLOW = ۵٬۰۰۰ تومان (همان بیننده ذخیره کرد → Follow.source=PROMO)
model PromoEvent {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  promoId          String   @db.ObjectId
  viewerBusinessId String   @db.ObjectId // خریداری که دید/ذخیره کرد
  type             String // VIEW | FOLLOW
  costMinor        Int
  createdAt        DateTime @default(now())

  promo Promo @relation(fields: [promoId], references: [id], onDelete: Cascade)

  @@unique([promoId, viewerBusinessId, type])
  @@index([viewerBusinessId])
}

// ─── فاز ۶ مهاجرت — چت کاری (sc-msgs / sc-chat) ──────────────────────────────
// گفتگو بین دو کسب‌وکار (خریدار ↔ تأمین‌کننده). «سابقهٔ معامله» است، نه
// ابزار چت عمومی: عکس کالا و قیمتِ گفته‌شده همیشه قابل مرور بماند.

/// گفتگو — بین دو کسب‌وکار. aId همیشه کوچکتر از bId ذخیره می‌شود تا
/// (a,b) یکتای بدون‌جهت باشد؛ سمت read، «طرف مقابلِ من» پروجکت می‌شود.
/// lastText/lastAt denormalized برای لیست سریع بدون join پیام‌ها.
model Thread {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  aId       String   @db.ObjectId
  bId       String   @db.ObjectId
  lastText  String?
  lastAt    DateTime @default(now())
  createdAt DateTime @default(now())

  a        Business  @relation("threadA", fields: [aId], references: [id], onDelete: Cascade)
  b        Business  @relation("threadB", fields: [bId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([aId, bId])
  @@index([aId, lastAt])
  @@index([bId, lastAt])
}

/// پیام — یک ردیف در گفتگو. متن + پیوستِ اختیاری عکس (File). readAt فقط
/// برای پیام‌های طرف مقابل معنا دارد (خواندنِ من) — پیام‌های خودم null.
model Message {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  threadId  String    @db.ObjectId
  senderId  String    @db.ObjectId // کسب‌وکار فرستنده
  text      String
  fileId    String?   @db.ObjectId // پیوست عکس — از /files/upload
  readAt    DateTime? // لحظهٔ خواندن توسط گیرنده
  createdAt DateTime  @default(now())

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

// ─── Specialized markets (FUTURE — additive overlay, not exposed yet) ────────
// Markets are fed FROM listings via per-market rules on reference goods.
// Deliberately kept in the schema now so no migration is needed later.

model Market {
  id          String             @id @default(auto()) @map("_id") @db.ObjectId
  slug        String             @unique
  title       String // e.g. "بازار پخش سوپرمارکتی همدان"
  description String?
  city        String? // optional geographic scope
  isActive    Boolean            @default(false)
  rules       MarketGoodRule[]
  members     MarketMembership[]

  @@index([isActive])
}

/// Feeding rule: which listings (of which reference good) and at what minimum
/// supply volume appear inside this market. Lives on the Market×Good relation
/// so two markets can keep different rules for the same good.
model MarketGoodRule {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  marketId  String @db.ObjectId
  goodId    String @db.ObjectId
  minVolume Float? // minimum sell volume (or capacity) to enter the market
  minPrice  Float?
  maxPrice  Float?

  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@unique([marketId, goodId])
}

/// Vetting: specialized markets can require approved membership per business.
model MarketMembership {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  marketId   String   @db.ObjectId
  businessId String   @db.ObjectId
  status     String   @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt  DateTime @default(now())

  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@unique([marketId, businessId])
}

// ─── Files ───────────────────────────────────────────────────────────────────

/// User-uploaded files — one polymorphic table that decorates every entity
/// needing images (User avatar, Business logo, Listing gallery, licenses, …).
///
/// Design (خواسته‌ی کاربر):
/// • relatedModel + relatedId point at the owner entity (User | Business |
///   Listing) — «یک به چند»: هر مدل می‌تواند بی‌نهایت فایل داشته باشد.
/// • fieldKey is the client-chosen slot («avatar», «logo», «gallery»,
///   «license», …) — همان کلیدی که هم هنگام آپلود و هم هنگام خواندن فرستاده
///   می‌شود؛ یک مدل می‌تواند چند اسلات و در هر اسلات چند فایل داشته باشد.
/// • Bytes live on the configured storage driver (Arvan S3 today; local disk
///   or another cloud tomorrow) — storageKey/thumbStorageKey are the
///   driver-level keys needed for deletes and provider switches.
/// • url/thumbUrl are PUBLIC direct CDN links: clients load bytes straight
///   from the cloud — the API never proxies file bodies (سرعت؛ بدون توکن).
/// • relatedId null = staged (uploaded before its model exists) — the admin
///   orphan cleaner reaps staged files after FILES_STAGING_TTL_DAYS.
model File {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  ownerId         String   @db.ObjectId
  owner           User     @relation("FileOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  /// "User" | "Business" | "Listing"
  relatedModel    String
  /// ObjectId of the decorated entity — null while staged
  relatedId       String?  @db.ObjectId
  /// client-chosen slot: avatar | logo | gallery | license | award | …
  fieldKey        String
  /// optional caption (خواسته‌ی کاربر — «فیلد توضیحات اختیاری»)
  description     String?
  /// original filename (display only)
  name            String
  /// normalized mime after processing (jpeg/png for images)
  mimeType        String
  /// bytes of the stored main file (after compression)
  size            Int
  /// public direct URL — no token, CDN-fast
  url             String
  thumbUrl        String?
  /// storage key of the main file (delete/switch-provider handle)
  storageKey      String
  /// storage key of the 400px thumbnail (images only)
  thumbStorageKey String?
  /// provider-specific extras (original size, dimensions, …)
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([relatedModel, relatedId, fieldKey])
  @@index([ownerId])
  @@index([relatedModel, relatedId])
  @@index([createdAt])
}

// ─── فاز ۵ مهاجرت — موتور قیمت‌گذاری: CustomerType × DiscountRule ──────────

/// قاعدهٔ تخفیف فروشنده — سه سطح (خاص‌تر برنده): CATALOG(کل) › GROUP(دستهٔ
/// شخصی کاتالوگ، refId=آیتم Business.customCategories) › ITEM(کالای مشخص،
/// refId=listingId). هر کسب‌وکار حداکثر یک قاعده در هر (scope, refId).
///
/// custPct: {p: عدد, h: عدد, q: عدد} — درصد تخفیف مشتری به تفکیک نوع
/// (گذری/همکار/قراردادی). سطح GROUP/ITEM فقط کلیدهای override را نگه می‌دارد
/// (خالی = همان سطح بالاتر؛ گذریِ گروه همان کاتالوگ می‌ماند — الگوی Prototype).
///
/// tiers: [{from, to|null, pct}] — پله‌های تخفیف حجمی بر حجمِ «همان کالا» در
/// سفارش؛ ردیف پایه (تا حداقل سفارش) ذخیره نمی‌شود — همیشه بدون تخفیف.
///
/// itemTri: {p|h|q: {kind: 'pct'|'amt'|'fin', value}} — فقط سطح ITEM: مبنای
/// ورودی سه‌گانه (درصد/مبلغ/قیمت نهایی) برای بازنمایی دقیق فرم؛ سرور همیشه
/// pct نتیجه‌شده را هم در custPct نگه می‌دارد تا محاسبهٔ قیمت یک‌منبع بماند.
model DiscountRule {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  businessId String   @db.ObjectId
  scope      String // CATALOG | GROUP | ITEM
  /// GROUP → id آیتم customCategories (فرمت آزاد) · ITEM → listingId (ObjectId)
  /// · CATALOG → "" —Plain String عمداً: دو قالب شناسه + سنتینل کاتالوگ
  refId      String?
  custPct    Json?
  tiers      Json?
  itemTri    Json?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([businessId, scope, refId])
  @@index([businessId, scope])
  @@index([refId])
}

// ─── فاز ۸ مهاجرت — تنظیمات سیستمی (AppSetting) ──────────────────────────────
// مخزن key/value برای سوییچ‌های ادمین و پیکربندی بین‌المللی. کلیدهای شناخته‌شده:
//   payments.enabled (bool)  — پرداخت درگاه فقط ایران؛ ادمین می‌تواند خاموش کند
//   currency.base    ("IRR") — ارز مرجع پایهٔ حسابداری (کیف پول/کمپین)
//   currency.rates   ({CODE: baseMinorPerMajor}) — نرخ‌ها: چند minor ارز مرجع
//                              برابر ۱ واحد اصلیِ آن ارز (rate.IRR = ۱۰ همیشه)
// مخزن است نه فایل env: تغییر از پنل ادمین بدون redeploy اعمال می‌شود.
model AppSetting {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  /// مقدار ساختاریافته — اعتبارسنجی در سرویس، نه اسکیما (کلیدهای متنوع)
  value     Json
  updatedAt DateTime @updatedAt
}
