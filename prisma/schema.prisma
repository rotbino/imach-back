// ─────────────────────────────────────────────────────────────────────────────
// iMach — Database Schema (MongoDB / Prisma)
//
// Design notes
// ─────────────
// • Good is the GLOBAL reference catalog: Business listings always reference it.
// • Listing is the atomic tradable unit (business × good, unique).
//   All interactions (Inquiry / Offer / Follow / PriceLog) hang off Listing,
//   so future "specialized markets" can be added as a pure curation overlay
//   (Market + MarketGoodRule) without touching the core tables.
// • Seller and buyer are the same entity (Business) — every business owns
//   BOTH arms (sell + buy); what is traded per good lives on Listing.mode.
// • Built for millions of rows:
//     - cursor pagination on _id (monotonic with ObjectId)
//     - compound indexes matching every hot query path
//     - Offer.score is persisted (historical results survive algorithm changes)
// • MongoDB connector has no native enums → validated as strings at the API
//   boundary (class-validator DTOs) so the data layer stays schema-agnostic.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  phone         String         @unique // identity: Iranian mobile number
  name          String
  passwordHash  String
  role          String         @default("MEMBER") // MEMBER | ADMIN
  country       String         @default("IR") // chosen at signup → default business currency
  businesses    Business[]
  refreshTokens RefreshToken[]
  /// Basic-data rows this user registered (goods, brands) — the audit trail of
  /// who grew the catalog. Null creator = system/seed row.
  createdGoods  Good[]         @relation("GoodCreator")
  createdBrands Brand[]        @relation("BrandCreator")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

/// Rotating refresh tokens — only the SHA-256 hash is stored, so a DB leak
/// cannot be replayed. Revoked rows keep audit history.
model RefreshToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  tokenHash String    @unique
  userId    String    @db.ObjectId
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ─── Catalog (category tree + reference goods) ─────────────────────────────

/// Category tree (3–4 levels). Seed comes from trade standards (GS1 GPC / HS
/// skeleton + local B2B naming); user-created goods always attach to a leaf.
model Category {
  id       String     @id @default(auto()) @map("_id") @db.ObjectId
  parentId String?    @db.ObjectId
  parent   Category?  @relation("catTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children Category[] @relation("catTree")
  slug     String     @unique // stable identifier — names are localizable
  nameFa   String
  nameEn   String
  /// Attribute schema for goods under this category:
  /// [{key, fa, en, type: "enum"|"text", options?: [{v, fa, en}]}]
  attrs    Json?
  goods    Good[]

  @@index([parentId])
}

/// The reference good — a tradeable CLASS ("خرمای خازویی"), NOT a brand×size SKU.
/// Weight/packaging live on Category attrs, brand lives on Listing — so the
/// catalog stays demand-driven and match-friendly across languages.
model Good {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  categoryId String    @db.ObjectId
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  nameFa     String // canonical Persian name (or the name the user typed)
  nameEn     String?
  aliases    String[]  // extra search terms in any language
  /// Normalized (fa-agnostic) concatenation of names + aliases — powers search
  searchText String
  unit       String // KILOGRAM | TON | CARTON | SACK | PIECE | LITER | BRANCH | METER | GRAM | SERVICE
  source     String    @default("SEED") // SEED | USER (legacy origin; superseded by creatorRole)
  status     String    @default("ACTIVE") // ACTIVE | PROVISIONAL (pending review)
  /// Who registered this row: USER (ordinary member) | ADMIN | BRAND_OWNER.
  /// Null = system/seed. Rows stay usable for everyone while PROVISIONAL —
  /// the state only drives the admin gardening queue (approve / merge / delete).
  creatorRole String?
  createdById String?   @db.ObjectId
  createdBy   User?     @relation("GoodCreator", fields: [createdById], references: [id], onUpdate: NoAction)
  listings   Listing[]

  @@index([categoryId])
  @@index([searchText])
}

/// Brand — optional, resolved/created on the fly when a listing saves.
/// Lives on the listing (not the reference) because the same class is sold
/// under many brands — and most B2B trade is brand-agnostic by default.
model Brand {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String // as entered
  searchText  String    @unique // normalized — natural dedup
  source      String    @default("SEED") // SEED | USER (legacy origin; superseded by creatorRole)
  /// ACTIVE | PROVISIONAL — same gardening contract as Good: pending brands
  /// keep working everywhere, they just wait in the admin queue.
  status      String    @default("ACTIVE")
  /// Who registered it: USER | ADMIN | BRAND_OWNER (null = system/seed).
  creatorRole String?
  createdById String?   @db.ObjectId
  createdBy   User?     @relation("BrandCreator", fields: [createdById], references: [id], onUpdate: NoAction)
  listings    Listing[]
}

// ─── Business (seller AND buyer identity) ────────────────────────────────────

// The 10 allowed activity types — validated at the API boundary
// (class-validator @IsIn), stored as a plain string:
// PRODUCER | WHOLESALER | RETAILER | DISTRIBUTOR | MERCHANT |
// SALES_AGENT | MARKETER | SERVICE_PROVIDER | CONTRACTOR | BUSINESS_CONSUMER

model Business {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  slug         String     @unique // drives the public arm links: /sell/{slug} /buy/{slug}
  name         String
  activityType String? // optional self-description, chosen later from the panel
  city         String
  province     String? // derived from city at write time (matching granularity)
  country      String     @default("IR") // country code of the business
  /// Currency of the catalog (sell arm). Set at business creation from the
  /// owner's signup country; every listing inherits it at write time.
  currency     String     @default("IRR") // ISO 4217
  phone        String?
  isVerified   Boolean    @default(false)
  isDemo       Boolean    @default(false)
  ownerId      String?    @db.ObjectId
  owner        User?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  listings     Listing[]  @relation("listings")
  inquiriesIn  Inquiry[]  @relation("seller")
  inquiriesOut Inquiry[]  @relation("buyer")
  offersSent   Offer[]    @relation("seller")
  offersRecv   Offer[]    @relation("buyer")
  following    Follow[]   @relation("buyer")
  followers    Follow[]   @relation("supplier")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([city])
  @@index([ownerId])
}

// ─── Listing (the atomic tradable unit) ──────────────────────────────────────

model Listing {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  businessId String   @db.ObjectId
  goodId     String   @db.ObjectId
  mode       String // SELL | BUY | BOTH

  /// Optional brand of THIS offer (the reference class stays brand-free)
  brandId String?    @db.ObjectId
  brand   Brand?     @relation(fields: [brandId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  // ── sell side ──
  /// Price in the SMALLEST currency unit (rial / cent …) — always an integer.
  /// Currency is inherited from the business at write time.
  priceMinor Int?
  currency   String? // ISO 4217 (IRR, USD, …)
  stock      Int?
  minOrder   Int?
  /// Category attribute values: {attrKey: value} (weight, packaging …)
  attrs Json?

  // ── buy side ──
  volume    Float?
  frequency String? // WEEKLY | MONTHLY | OCCASIONAL

  business  Business   @relation("listings", fields: [businessId], references: [id], onDelete: Cascade)
  good      Good       @relation(fields: [goodId], references: [id])
  inquiries Inquiry[]
  offers    Offer[]
  priceLogs PriceLog[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([businessId, goodId])
  @@index([goodId, mode])
  @@index([businessId])
}

// ─── Interactions ────────────────────────────────────────────────────────────

/// Buyer asked for a price on a seller's catalog listing.
model Inquiry {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  buyerId   String   @db.ObjectId
  sellerId  String   @db.ObjectId
  listingId String   @db.ObjectId
  volume    Float
  note      String?
  status    String   @default("NEW") // NEW | ANSWERED | ARCHIVED
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  buyer   Business @relation("buyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller  Business @relation("seller", fields: [sellerId], references: [id], onDelete: Cascade)
  listing Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([sellerId, isRead, createdAt])
  @@index([buyerId, createdAt])
}

/// A price offer — either produced by the matching engine on quote-request,
/// or sent manually by a seller answering an inquiry.
model Offer {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  buyerId   String   @db.ObjectId
  sellerId  String   @db.ObjectId
  listingId String   @db.ObjectId
  priceMinor Int // smallest currency unit — integer, exact
  currency   String // ISO 4217 — snapshotted from the listing
  minOrder  Int
  score     Int // persisted matching score (0–100)
  isSpecial Boolean  @default(false)
  note      String?
  createdAt DateTime @default(now())

  buyer   Business @relation("buyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller  Business @relation("seller", fields: [sellerId], references: [id], onDelete: Cascade)
  listing Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
}

/// Buyer follows a supplier → the followed prices appear on the live board.
model Follow {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  buyerId    String   @db.ObjectId
  supplierId String   @db.ObjectId
  createdAt  DateTime @default(now())

  buyer    Business @relation("buyer", fields: [buyerId], references: [id], onDelete: Cascade)
  supplier Business @relation("supplier", fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([buyerId, supplierId])
  @@index([supplierId])
}

/// Price history per listing → powers trends and "recently updated" badges.
/// Minor-unit integers — same precision as the listing itself.
model PriceLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  listingId String   @db.ObjectId
  oldMinor  Int
  newMinor  Int
  createdAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, createdAt])
}

// ─── Specialized markets (FUTURE — additive overlay, not exposed yet) ────────
// Markets are fed FROM listings via per-market rules on reference goods.
// Deliberately kept in the schema now so no migration is needed later.

model Market {
  id          String             @id @default(auto()) @map("_id") @db.ObjectId
  slug        String             @unique
  title       String // e.g. "بازار پخش سوپرمارکتی همدان"
  description String?
  city        String? // optional geographic scope
  isActive    Boolean            @default(false)
  rules       MarketGoodRule[]
  members     MarketMembership[]

  @@index([isActive])
}

/// Feeding rule: which listings (of which reference good) and at what minimum
/// supply volume appear inside this market. Lives on the Market×Good relation
/// so two markets can keep different rules for the same good.
model MarketGoodRule {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  marketId  String  @db.ObjectId
  goodId    String  @db.ObjectId
  minVolume Float? // minimum sell volume (or capacity) to enter the market
  minPrice  Float?
  maxPrice  Float?

  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@unique([marketId, goodId])
}

/// Vetting: specialized markets can require approved membership per business.
model MarketMembership {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  marketId   String   @db.ObjectId
  businessId String   @db.ObjectId
  status     String   @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt  DateTime @default(now())

  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@unique([marketId, businessId])
}
