# iMach API — copy to .env and fill real values

PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Database — MongoDB Atlas replica set
DATABASE_URL="mongodb://<user>:<password>@cluster-shard-00-00.xxxxx.mongodb.net:27017,cluster-shard-00-01.xxxxx.mongodb.net:27017,cluster-shard-00-02.xxxxx.mongodb.net:27017/<dbname>?ssl=true&replicaSet=<rs-name>&authSource=admin"

# JWT — use a strong random secret (>= 32 bytes). Rotate regularly.
JWT_SECRET="<generate with: openssl rand -hex 32>"
# Access-token lifetime (e.g. 15m recommended; 7d is convenient but less secure)
JWT_EXPIRES_IN="15m"

# Refresh-token rotation lifetime (days)
REFRESH_TOKEN_TTL_DAYS=30

# CORS — comma-separated origins, "*" allows all (set explicitly in production)
CORS_ORIGINS="https://your-frontend-domain.com"

# Swagger UI at /docs (disable in production)
SWAGGER_ENABLED=true
