# ── iMach API environment ────────────────────────────────────────────────────
# Copy to .env and fill real values. The real .env is gitignored.

PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# MongoDB Atlas connection string (Prisma / mongodb connector)
DATABASE_URL="mongodb://USER:PASSWORD@cluster-shard-00-00.xxx.mongodb.net:27017,.../imach_online_db?ssl=true&replicaSet=...&authSource=admin"

# Access-token signing secret (>= 16 chars) + expiry
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Rotating refresh-token lifetime (days, httpOnly cookie)
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated origins, or * for any
CORS_ORIGINS="*"

# OpenAPI docs at /docs
SWAGGER_ENABLED=true

# ── Web Push (VAPID) ─────────────────────────────────────────────────────────
# Open standard — NO Google/Firebase account needed.
# Generate the pair once with:  npx web-push generate-vapid-keys
# If left empty, push endpoints answer but sending is disabled (app keeps working).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact URI sent to push services (RFC 8292). Use a mailto: you own.
VAPID_SUBJECT="mailto:support@imach.ir"

# ── Storage (files) ──────────────────────────────────────────────────────────
# arvan = S3-compatible object storage (public-read objects, CDN-fast reads)
# local = plain disk under UPLOAD_PATH (self-hosted fallback)
STORAGE_DRIVER=arvan
MAX_FILE_SIZE=10485760
UPLOAD_PATH="./uploads"
# Staged files (relatedId null) older than this many days are reapable orphans
FILES_STAGING_TTL_DAYS=7

# ==================== ARVAN STORAGE ====================
ARVAN_ENDPOINT=https://<bucket>.s3.<region>.arvanstorage.ir
ARVAN_REGION=ir-thr-at1
ARVAN_ACCESS_KEY=
ARVAN_SECRET_KEY=
ARVAN_BUCKET_NAME=
